generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  TRAINER
  MANAGER
  EMPLOYEE
}

model Organization {
  id          Int          @id @default(autoincrement())
  name        String
  industry    String?
  subscription String?
  createdAt   DateTime     @default(now())

  departments Department[]
  users       User[]
}

model Department {
  id             Int          @id @default(autoincrement())
  name           String
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  users          User[]
}

model User {
  id             Int           @id @default(autoincrement())
  name           String
  email          String        @unique
  passwordHash   String
  role           Role          @default(EMPLOYEE)
  status         String        @default("active")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  departmentId   Int?
  department     Department?   @relation(fields: [departmentId], references: [id])

  progress       TrainingProgress[]
  incidents      Incident[]
  notifications  Notification[]
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  category    String?
  difficulty  String?  @default("beginner")
  duration    Int?     // in minutes
  status      String   @default("draft")
  createdBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
  quizzes     Quiz[]
  progress    TrainingProgress[]
}

model Lesson {
  id          Int      @id @default(autoincrement())
  title       String
  content     String?
  videoUrl    String?
  orderNumber Int      @default(1)
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Quiz {
  id           Int        @id @default(autoincrement())
  title        String
  passingScore Int        @default(60)
  courseId     Int
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    Question[]
  createdAt    DateTime   @default(now())
}

model Question {
  id           Int      @id @default(autoincrement())
  text         String
  questionType String   @default("multiple_choice")
  quizId       Int
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers      Answer[]
}

model Answer {
  id          Int      @id @default(autoincrement())
  text        String
  isCorrect   Boolean  @default(false)
  explanation String?
  questionId  Int
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model TrainingProgress {
  id           Int      @id @default(autoincrement())
  userId       Int
  courseId     Int
  quizId       Int?
  score        Int?
  passed       Boolean  @default(false)
  status       String   @default("in_progress")
  completedAt  DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
  course       Course   @relation(fields: [courseId], references: [id])
}

model Campaign {
  id           Int                @id @default(autoincrement())
  name         String
  description  String?
  emailSubject String
  emailBody    String
  difficulty   String             @default("medium")
  status       String             @default("draft")
  createdBy    Int?
  createdAt    DateTime           @default(now())
  events       SimulationEvent[]
}

model SimulationEvent {
  id         Int      @id @default(autoincrement())
  campaignId Int
  userId     Int
  eventType  String   // EMAIL_SENT, EMAIL_OPENED, LINK_CLICKED, REPORT_SUBMITTED, CREDENTIAL_ATTEMPT
  timestamp  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Incident {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  type         String   @default("phishing")   // phishing, malware, suspicious_email, other
  severity     String   @default("medium")      // low, medium, high, critical
  status       String   @default("open")        // open, reviewing, resolved, dismissed
  reportedById Int
  reviewNotes  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reportedBy   User     @relation(fields: [reportedById], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  type      String   @default("info")   // info, success, warning, alert
  link      String?                       // optional route to navigate to
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int                          // who performed the action
  actorName  String                        // stored for easy display
  action     String                        // e.g. ROLE_CHANGED, USER_DEACTIVATED
  targetType String?                       // e.g. "user", "incident"
  targetId   Int?
  details    String?                       // human-readable summary
  createdAt  DateTime @default(now())
}